{
  "name": "@lumora/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "encore run",
    "build": "encore build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "db:seed:local": "DATABASE_URL=$(encore db conn-uri lumora) bun seed-local.ts"
  },
  "dependencies": {
    "@lumora/auth": "workspace:*",
    "@lumora/config": "workspace:*",
    "@lumora/database": "workspace:*",
    "@lumora/shared": "workspace:*",
    "@lumora/validation": "workspace:*",
    "better-auth": "^1.6.25",
    "drizzle-orm": "1.0.0-rc.4",
    "encore.dev": "^1.57.13",
    "pg": "^8.22.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
